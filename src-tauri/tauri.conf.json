{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trayload",
  "version": "1.1.5",
  "identifier": "com.loxianthepeak.trayload",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Trayload",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALAPPDATA/com.loxianthepeak.trayload/art/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Trayload contributors",
    "copyright": "Copyright (c) 2026 Trayload contributors",
    "category": "Game",
    "shortDescription": "Emulator launcher for Windows",
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "resources": [
      "resources/music/trayload/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDOTlGQTM5RDBDMDg3RUIKUldUcmg4RFFPZnFaVEtwRzZ1ajdwRE9vVXNncFJScXBJcTlpcEpoUFlpZzBHTUMrZ1Z5V0VxOEcK",
      "endpoints": [
        "https://github.com/Frontloxian/trayload/releases/latest/download/latest.json"
      ]
    }
  }
}
