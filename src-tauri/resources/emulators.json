  {
   "id": "gc",
   "name": "GameCube",
   "emulator": "Dolphin",
   "source": {
    "type": "page",
    "url": "https://dolphin-emu.org/download/",
    "assetPattern": "https://dl\\.dolphin-emu\\.org/releases/[^\"'\\s<>]+?-x64\\.7z",
    "fallbackUrl": "https://dl.dolphin-emu.org/releases/2609b/dolphin-2609b-x64.7z"
   },
   "exts": [
    "iso",
    "gcm",
    "rvz",
    "gcz"
   ],
   "exePattern": "^dolphin\\.exe$",
   "portableMarker": "portable.txt",
   "launchArgs": [
    "-b",
    "-e",
    "{rom}"
   ],
   "artRepos": [
    "Nintendo_-_GameCube"
   ],
   "setup": {
    "folder": "User/GC",
    "intro": "GameCube games run without any extra files.",
    "items": [
     {
      "label": "GameCube BIOS (IPL.bin)",
      "required": false,
      "namePattern": "^IPL\\.bin$",
      "deep": true,
      "note": "Optional. Only needed to see the GameCube boot logo. Put it in a USA, EUR or JAP folder inside this one."
     }
    ]
   }
  },
