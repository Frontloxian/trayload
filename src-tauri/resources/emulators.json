{
  "_note": "Windows registry. 'source' tells the launcher where to fetch the latest build; 'assetPattern' is a regex matched against release asset names. Patterns are first guesses: verify each against the real release page before shipping.",
  "revision": 1,
  "systems": [
    {
      "id": "nes",
      "name": "NES / Famicom",
      "emulator": "Mesen 2",
      "source": {
        "type": "github",
        "repo": "SourMesen/Mesen2",
        "assetPattern": "Windows\\.zip$"
      },
      "exts": [
        "nes",
        "fds",
        "unf"
      ],
      "artRepos": [
        "Nintendo_-_Nintendo_Entertainment_System"
      ],
      "exePattern": "^Mesen\\.exe$",
      "launchArgs": [
        "{rom}"
      ],
      "setup": {
        "folder": ".",
        "intro": "Nintendo NES and Famicom games run without extra files.",
        "items": [
          {
            "label": "Famicom Disk System BIOS (disksys.rom)",
            "required": false,
            "namePattern": "^disksys\\.rom$",
            "sizes": [
              8192
            ],
            "deep": true,
            "note": "Optional. Only for Famicom Disk System games. Put it in the Firmware folder."
          }
        ]
      },
      "backup": [
        "Saves",
        "SaveStates",
        "settings.json"
      ]
    },
    {
      "id": "snes",
      "name": "Super Nintendo",
      "emulator": "Mesen 2",
      "source": {
        "type": "github",
        "repo": "SourMesen/Mesen2",
        "assetPattern": "Windows\\.zip$"
      },
      "exts": [
        "sfc",
        "smc",
        "fig"
      ],
      "artRepos": [
        "Nintendo_-_Super_Nintendo_Entertainment_System"
      ],
      "exePattern": "^Mesen\\.exe$",
      "launchArgs": [
        "{rom}"
      ],
      "setup": {
        "folder": ".",
        "intro": "Most Super Nintendo games run without extra files.",
        "items": [
          {
            "label": "Extra-chip firmware (dsp1.rom, st010.rom and similar)",
            "required": false,
            "namePattern": "^(dsp[1-4]b?|st01[018]|cx4)\\.(rom|bin)$",
            "deep": true,
            "note": "Optional. Only a few games with special chips ask for these."
          }
        ]
      },
      "backup": [
        "Saves",
        "SaveStates",
        "settings.json"
      ]
    },
