      "launchArgs": [
        "-g",
        "{rom}"
      ],
      "warning": "Needs prod.keys and firmware dumped from your own Switch. Trayload never provides or links them. Eden is downloaded from its official release server (git.eden-emu.dev, with files from stable.eden-emu.dev).",
      "setup": {
        "folder": "user",
        "intro": "Eden needs prod.keys, and many games also need firmware, both from your own Switch. Trayload doesn't provide or link them.",
        "items": [
          {
            "label": "Switch keys (prod.keys)",
            "required": true,
            "namePattern": "^prod\\.keys$",
            "deep": true,
            "note": "Goes in the keys folder inside this one."
          },
          {
            "label": "Switch firmware",
            "required": false,
            "namePattern": "\\.nca$",
            "deep": true,
            "note": "Needed by many games. Install it from inside Eden (Tools, then Install Firmware)."
          }
        ]
      },
      "backup": [
        "user/nand/user/save",
        "user/config"
      ]
