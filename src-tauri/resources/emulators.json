      "required": false,
      "namePattern": "^firmware\\.bin$",
      "sizes": [
       131072,
       262144,
       524288
      ],
      "deep": true,
      "note": "Set the paths in melonDS under Config, Emu settings, DS-mode."
     }
    ]
