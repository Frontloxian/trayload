  {
   "id": "switch",
   "name": "Nintendo Switch",
   "emulator": "Eden",
   "source": {
    "type": "forgejo",
    "host": "git.eden-emu.dev",
    "repo": "eden-emu/eden",
    "assetPattern": "^Eden-Windows-.*-amd64-msvc-standard\\.zip$"
   },
   "exts": [
    "nsp",
    "xci"
   ],
   "exePattern": "^eden\\.exe$",
   "portableMarker": "user/",
   "launchArgs": [
    "-g",
    "{rom}"
   ],
   "warning": "Needs prod.keys and firmware dumped from your own Switch. Trayload never provides or links them. Eden is downloaded from its official release server (git.eden-emu.dev, with files from stable.eden-emu.dev).",
   "setup": {
    "folder": "user",
    "intro": "Eden needs prod.keys, and many games also need firmware, both from your own Switch. Trayload doesn't provide or link them.",
    "items": [
     {
      "label": "Switch keys (prod.keys)",
      "required": true,
      "namePattern": "^prod\\.keys$",
      "deep": true,
      "note": "Goes in the keys folder inside this one."
     },
     {
      "label": "Switch firmware",
      "required": false,
      "namePattern": "\\.nca$",
      "deep": true,
      "note": "Needed by many games. Install it from inside Eden (Tools, then Install Firmware)."
     }
    ]
   }
  },
  {
   "id": "switch2",
   "name": "Nintendo Switch 2",
   "emulator": "Lichii",
   "tier": "experimental",
   "source": {
    "type": "github",
    "repo": "zortos293/Lichii",
    "assetPattern": "^lichii-windows-x86_64\\.zip$"
   },
   "exts": [],
   "exePattern": "^lichii.*\\.exe$",
   "warning": "Experimental. Switch 2 emulation is very early: expect crashes, missing games and changes without notice. It needs keys and firmware from your own console. Trayload downloads it only from github.com/zortos293/Lichii, and games can't be started from Trayload yet."
  },
  {
   "id": "ps1",
   "name": "PlayStation",
   "emulator": "DuckStation",
   "source": {
    "type": "github",
    "repo": "stenzek/duckstation",
    "assetPattern": "windows-x64.*\\.zip$"
   },
   "exts": [
    "bin",
    "cue",
    "chd",
    "pbp"
   ],
   "exePattern": "^duckstation-qt.*\\.exe$",
   "portableMarker": "portable.txt",
   "launchArgs": [
    "-batch",
    "--",
    "{rom}"
   ],
   "artRepos": [
    "Sony_-_PlayStation"
   ],
   "setup": {
    "folder": "bios",
    "intro": "DuckStation needs a PlayStation BIOS file from your own console. One file is enough.",
    "items": [
     {
      "label": "PlayStation BIOS",
      "required": true,
      "sizes": [
       524288
      ],
      "note": "A 512 KB .bin file (for example scph5501.bin). Pick one that matches your games' region."
     }
    ]
   }
  },
